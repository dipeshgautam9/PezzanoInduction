// api/identify-product.js
// Identifies which product a staff photo shows from a list of candidates.
// Uses Gemini vision — same GEMINI_API_KEY as ask-ai.js, no new secret needed.

export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }
  const apiKey = process.env.GEMINI_API_KEY;
  if (!apiKey) return res.status(500).json({ error: 'GEMINI_API_KEY is not set.' });

  const { staffPhoto, candidates } = req.body || {};
  if (!staffPhoto) return res.status(400).json({ error: 'A photo is required.' });
  if (!Array.isArray(candidates) || !candidates.length) return res.status(400).json({ error: 'No candidate products provided.' });

  function splitDataUrl(dataUrl) {
    const match = /^data:(image\/[a-zA-Z0-9.+-]+);base64,(.+)$/.exec(dataUrl);
    if (!match) return null;
    return { mimeType: match[1], base64: match[2] };
  }

  try {
    const img = splitDataUrl(staffPhoto);
    if (!img) return res.status(400).json({ error: 'Photo format not readable.' });

    const nameList = candidates.map((c, i) => `${i + 1}. ${c.name}${c.category ? ` (${c.category})` : ''}`).join('\n');
    const prompt = `You are a produce and warehouse product identification expert. Look at this warehouse product photo carefully.

Here are the candidate products this could be (numbered list):
${nameList}

Identify which single product is shown in the photo. Use your knowledge of produce appearance, packaging, and warehouse items to make the best match.

Important: if you can see a product in the photo that COULD match one of the candidates, make your best guess — even if the photo is not perfect quality. Only say "no match" if the photo is completely unrecognisable or shows something entirely different from all candidates.

Respond with STRICT JSON ONLY — no markdown, no explanation outside the JSON:
{"match": true|false, "index": <1-based number from the list, or null if no match>, "confidence": 0.0-1.0, "reason": "one short phrase"}`;

    const geminiRes = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key=${apiKey}`,
      {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ role: 'user', parts: [
            { text: prompt },
            { inline_data: { mime_type: img.mimeType, data: img.base64 } }
          ]}],
          generationConfig: { temperature: 0.05, maxOutputTokens: 200 }
        })
      }
    );

    if (!geminiRes.ok) {
      // Try fallback model if primary fails
      const errText = await geminiRes.text();
      console.error('Gemini identify error:', errText);
      return res.status(502).json({ error: 'AI service error. Please try again.' });
    }

    const data = await geminiRes.json();
    let raw = data.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || '';
    raw = raw.replace(/^```json\s*/i, '').replace(/^```\s*/, '').replace(/```\s*$/, '').trim();

    let parsed;
    try { parsed = JSON.parse(raw); }
    catch (e) {
      console.error('identify-product parse error:', raw);
      // If we got text but can't parse, try a looser extract
      const idxMatch = raw.match(/"index"\s*:\s*(\d+)/);
      const confMatch = raw.match(/"confidence"\s*:\s*([\d.]+)/);
      if (idxMatch) {
        const idx = parseInt(idxMatch[1]) - 1;
        const confidence = confMatch ? parseFloat(confMatch[1]) : 0.5;
        if (idx >= 0 && idx < candidates.length) {
          return res.status(200).json({ productId: candidates[idx].id, productName: candidates[idx].name, confidence });
        }
      }
      return res.status(200).json({ productId: null });
    }

    const idx = typeof parsed.index === 'number' ? parsed.index - 1 : -1;
    const confidence = typeof parsed.confidence === 'number' ? parsed.confidence : 0;
    // Lower threshold to 0.35 — warehouse photos are often imperfect and we'd
    // rather give a named result with a caveat than refuse to identify anything.
    if (parsed.match && idx >= 0 && idx < candidates.length && confidence >= 0.35) {
      return res.status(200).json({ productId: candidates[idx].id, productName: candidates[idx].name, confidence });
    }
    return res.status(200).json({ productId: null, confidence });
  } catch (err) {
    console.error('identify-product error:', err);
    return res.status(500).json({ error: 'Something went wrong. Please try again.' });
  }
}
